# Bottega deployment environment. Copy to .env (gitignored) and fill in.
# Every value here is a placeholder — never commit real credentials.

# --- Channel tokens (server-side only, issue #9) --------------------------
# Used by the Slack Socket Mode adapter. They live in the server .env only:
# never in the executor image or agent sessions.
SLACK_APP_TOKEN=xapp-1-...replace-with-app-token
SLACK_BOT_TOKEN=xoxb-...replace-with-bot-token

# --- Model provider key ---------------------------------------------------
# NEAR.ai API key, referenced by name from config/omp/models.yml
# (providers.near.apiKey). Resolved by the OMP SDK inside the server
# process; the executor env carries no provider keys.
NEAR_API_KEY=...replace-with-near-api-key

# --- Auth boundary (broker vault, issue #9) -------------------------------
# Server + executor resolve provider credentials through the auth-broker
# (OMP_AUTH_BROKER_URL). The token is generated at broker first boot into
# the data volume (0600) — copy it into .env once:
#   docker compose exec auth-broker cat /data/.omp/auth-broker.token
OMP_AUTH_BROKER_URL=http://auth-broker:8765
OMP_AUTH_BROKER_TOKEN=...replace-with-token-from-data-volume

# --- Git auth (executor, issue #11) ----------------------------------------
# Fine-grained PAT used by the executor's git credential helper + GitHub API
# PR creation. Never in env/image — the executor reads it from the FILE at
# EXECUTOR_GIT_TOKEN_FILE (mode 0600; data volume in the container):
#   install -m 0600 github_pat_... data/secrets/github-pat
GITHUB_PAT=github_pat_...replace-with-pat
EXECUTOR_GIT_TOKEN_FILE=data/secrets/github-pat
# Workspace root for work-item checkouts (/workspaces in the container).
WORKSPACES_DIR=/workspaces
# GitHub REST API base for PR creation (default https://api.github.com;
# point at a self-hosted GitHub instance where needed).
# EXECUTOR_GITHUB_API_URL=https://api.github.com
# Repo allowlist override (comma-separated "owner/repo"); config/org.yml by
# default (issue #47). An ALLOWLIST, not routing: the executor refuses any
# work-item repo not listed here. Empty → no pushes until configured.
# EXECUTOR_REPOS=acme/sandbox
# Local dev only: tolerate a PAT file mode other than 0600 (the executor
# fails boot closed on mode != 0600). Never set in production.
# BOTTEGA_ALLOW_LOOSE_PAT=1

# --- Memory backend: Mem0 (issues #21, #43) --------------------------------
# Self-hosted mem0 OSS REST server (docs.mem0.ai/open-source), shipped as the
# `mem0` compose service. MEM0_BASE_URL is prefilled with the internal
# compose URL — the server switches to the mem0 provider whenever it is set
# (SQLite is the fallback). Point it at http://localhost:8888 when running
# the mem0 server outside compose. MEM0_API_KEY is optional — the OSS server
# only demands a key when its auth isn't disabled (AUTH_DISABLED=true is for
# local development). No live key is committed anywhere in this repo.
MEM0_BASE_URL=http://mem0:8000
# MEM0_API_KEY=m0sk_...replace-with-api-key
# The mem0 service needs an LLM key for its embedder/extractor — the
# container refuses to boot without it ("api_key client option must be set").
# Fail-closed: set OPENAI_API_KEY whenever the mem0 service is up.
# OPENAI_API_KEY=...replace-with-openai-api-key

# --- Optional -------------------------------------------------------------
# Org config dir override for the policy floor (src/policy/config.ts).
# BOTTEGA_CONFIG_DIR=config
# --- MCP surface (issue #25) ----------------------------------------------
# Env contract of the bottega-hosted MCP server (`bun run src/mcp/server.ts`),
# which the ACP driver attaches to sessions via session/new's mcpServers.
# The driver injects BOTTEGA_SPACE_ID per session and absolutizes the two
# path vars (the MCP server process runs with the agent's session cwd).
BOTTEGA_DB_PATH=data/bottega.db
# BOTTEGA_SPACE_ID=
# BOTTEGA_MCP_DEFAULT_PRINCIPAL=
# Image tag the app services run (docker-compose.yml). Pin a known-good
# build per deploy — rollback = set this to the previous tag and up -d:
#   BOTTEGA_IMAGE_TAG=$(git rev-parse --short HEAD) docker compose build
BOTTEGA_IMAGE_TAG=local
# Future HTTP surfaces (no listener today).
# PORT=3000
