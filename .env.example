# Bottega deployment environment. Copy to .env (gitignored) and fill in.
# Every value here is a placeholder — never commit real credentials.
#
# .env carries SECRETS + deployment identity only (issue #67). Runtime knobs
# (workspaces dir, repo allowlist, git/api base URLs, mem0 backend URL,
# approval timeouts, response mode, memory injection, extensions policy,
# model defaults) live in the org settings blob in the DB (org_settings),
# editable via the `settings` tool — not in .env. models.yml is generated at
# boot from those settings; the committed config/omp/models.yml is the
# no-settings default template.
#
# Local dev (issues #123, #126, #143, #311): preview with `bun run setup`,
# then explicitly create/reuse the shared proxy and broker boundaries with
# `bun run setup -- --apply`. `bun run dev` only validates readiness and
# starts the server; it performs no hidden setup mutations. The proxy uses
# the DEV-PERMISSIVE generated config (allow-all + no judge, with secrets
# and management retained). Setup owns the mode-0600 management and broker
# token files and exports them to dev without printing their values. Nothing
# broker-related needs setting here. No judge key is needed for dev.

# --- Channel tokens (server-side only, issue #9) --------------------------
# Used by the Slack Socket Mode adapter. They live in the server .env only:
# never in the executor image or agent sessions.
# Vault-backed (issue #201): the boot seeds these from the auth-broker
# vault when rows exist (provider ids slack-app / slack-bot — provision
# with `connect_upload_link`), with .env as the fallback. Fail closed: a
# missing row + missing env refuses to boot.
SLACK_APP_TOKEN=xapp-1-...replace-with-app-token
SLACK_BOT_TOKEN=xoxb-...replace-with-bot-token

# --- Model provider keys --------------------------------------------------
# Vault-backed (issue #201): the boot seeds each key from the auth-broker
# vault when a row exists (provider ids opencode / near / openai /
# anthropic — provision with `connect_upload_link`), with .env as the
# fallback. The models.yml apiKey references stay BY NAME (the SDK is
# unchanged); only the source of truth moves. Local dev can opt in to the
# macOS Keychain fallback (service: bottega-<provider>, for example
# bottega-opencode) with BOTTEGA_KEYCHAIN_SEED=1.
# Primary model key (issue #37): referenced by name from config/omp/models.yml
# (providers.opencode-go.apiKey), resolved by the OMP SDK inside the server
# process; the executor env carries no provider keys.
OPENCODE_API_KEY=...replace-with-opencode-api-key
# Fallback NEAR.ai API key, referenced by name from config/omp/models.yml
# (providers.near.apiKey). Resolved by the OMP SDK inside the server
# process; the executor env carries no provider keys.
NEAR_API_KEY=...replace-with-near-api-key
# OpenAI (ChatGPT) API key, referenced by name from config/omp/models.yml
# (providers.openai.apiKey). Resolved by the OMP SDK inside the server
# process; the executor env carries no provider keys. Also the mem0
# embedder/extractor key when the memory backend is up (see below).
OPENAI_API_KEY=...replace-with-openai-api-key
# Anthropic (Claude) API key, referenced by name from config/omp/models.yml
# (providers.anthropic.apiKey). Resolved by the OMP SDK inside the server
# process; the executor env carries no provider keys.
ANTHROPIC_API_KEY=...replace-with-anthropic-api-key

# --- Ingest webhooks (issue #57) ------------------------------------------
# The GitHub webhook shared secret (X-Hub-Signature-256 verification for
# POST /webhooks/github). Vault-backed (issue #201): provision it into the
# auth-broker vault with `connect_upload_link github-webhook`, with .env as
# the fallback. Unset → the webhook leg fails closed per delivery (401,
# nothing dispatched).
GITHUB_WEBHOOK_SECRET=...replace-with-github-webhook-secret

# --- Auth boundary (broker vault, issue #9) -------------------------------
# Server + executor resolve provider credentials through the auth-broker
# (OMP_AUTH_BROKER_URL); the extension runtime's broker secret resolver
# (issue #54 wiring, #143) fetches each resolved credential's payload from
# the vault with a bearer read from this mode-0600 file at resolution time.
# Keep the explicit OMP_AUTH_BROKER_TOKEN override unset in deployment:
# it is supported for local development and takes priority when present.
OMP_AUTH_BROKER_URL=http://auth-broker:8765
OMP_AUTH_BROKER_TOKEN_FILE=data/.omp/auth-broker.token

# --- 1Password Connect (optional secret-vault backend, issue #190) --------
# Access token for the org's 1Password Connect server. Only needed when the
# org settings blob selects `secrets_backend: {type: 1password-connect, ...}`
# (the extension credential boundary then resolves static credentials — API
# keys / PATs — from the Connect server instead of the broker vault). The
# Connect server URL and the "provider:identityKey" → {vault, item, field}
# mapping are runtime knobs: they live in the org settings blob (settings
# tool), NOT in .env — only this secret does. Omit entirely when using the
# default omp-broker backend.
OP_CONNECT_TOKEN=...replace-with-connect-access-token

# --- Egress judge (iron-proxy, issue #8) -----------------------------------
# LLM key for iron-proxy's judge transform in the STRICT deployment config
# (config/egress.yml -> judge provider.api_key_env). The judge gates every
# allowlisted request and fails closed without a working key — without it,
# model traffic is denied in deployment. The proxy reads it from its own
# container env (compose passes it through).
# NOT needed for local dev (issue #126): the dev config
# (config/egress.dev.yml) has no judge transform — dev.sh never resolves
# this key.
NEARAI_JUDGE_API_KEY=...replace-with-judge-api-key

# --- Boundary management API (iron-proxy, issue #123) ----------------------
# Bearer token for iron-proxy's operator API (config/egress.yml ->
# management.api_key_env). The extension credential boundary calls
# POST /v1/reload with it after writing each secret file, so credential
# rotation applies immediately (no proxy restart). Fail-closed: a reload
# without the valid token is 401, and the server only wires the reload when
# BOTH the control URL and this token are set (unset -> write-only boundary,
# the hermetic fallback — files still rotate via the secrets transform's
# ttl re-read).
# Local dev: explicit `bun run setup -- --apply` generates the per-machine
# mode-0600 token and passes it to proxy startup. `bun run dev` reads it only
# into the child environment and never prints it. Nothing to set here.
IRON_MANAGEMENT_API_KEY=...replace-with-management-api-token

# --- Git auth (executor, issue #11) ----------------------------------------
# Fine-grained PAT used by the executor's git credential helper + GitHub API
# PR creation. Never in env/image — the executor reads it from the FILE at
# EXECUTOR_GIT_TOKEN_FILE (mode 0600; data volume in the container):
#   install -m 0600 github_pat_... data/secrets/github-pat
GITHUB_PAT=github_pat_...replace-with-pat
EXECUTOR_GIT_TOKEN_FILE=data/secrets/github-pat

# --- Memory backend (issues #21, #43, #67) ---------------------------------
# The mem0 service needs an LLM key for its embedder/extractor — the
# container refuses to boot without it ("api_key client option must be set").
# Fail-closed: the OPENAI_API_KEY defined in the model provider section
# above must be set whenever the mem0 service is up.
# MEM0_API_KEY is optional — the OSS server only demands a key when its auth
# isn't disabled (AUTH_DISABLED=true is for local development). No live key
# is committed anywhere in this repo.
# MEM0_API_KEY=m0sk_...replace-with-api-key
# The BACKEND URL is a setting, not an env var (issue #67): unset → SQLite
# memory; set org settings `memory_backend.base_url` (via the settings tool)
# to switch to the mem0 service, e.g. http://mem0:8000 (compose internal) or
# http://localhost:8888 outside compose. Restart the server to apply.

# --- Internal search (issue #388) ------------------------------------------
# Internal SearXNG session/signing secret; generate with: openssl rand -hex 32
SEARXNG_SECRET=

# --- Optional -------------------------------------------------------------
# Org config dir override for the policy floor (src/policy/config.ts).
# BOTTEGA_CONFIG_DIR=config
# --- MCP surface (issue #25) ----------------------------------------------
# Env contract of the bottega-hosted MCP server (`bun run src/mcp/server.ts`):
# the caller injects BOTTEGA_SPACE_ID per session and absolutizes the two
# path vars (the MCP server process runs with the agent's session cwd).
BOTTEGA_DB_PATH=data/bottega.db
# BOTTEGA_SPACE_ID=
# BOTTEGA_MCP_DEFAULT_PRINCIPAL=

# --- Public ingress (issues #196, #198, #249) -------------------------------
# The browser-facing base URL of the deployment's ONE public ingress (the
# reverse proxy / tunnel in front of the server). The SAME base serves BOTH
# browser legs: the OAuth callback (`<base>/oauth/callback`, issue #198) and
# the one-time upload link (`<base>/upload/<token>`, issue #196). The mints
# return this public URL — a browser on a remote host (or behind the MITM
# proxy) reaches the form through the ingress; the in-process listeners
# themselves stay 127.0.0.1-only, the tunnel forwards to them.
# Resolution order (issue #249) — the DURABLE STORE first, this env second:
#   1. data/public-base-url — the LIVE public base written by
#      scripts/tunnel.sh (the cloudflared quick-tunnel companion) on every
#      rotation. It is re-read on every mint, so a rotated tunnel host
#      self-heals the next connect/upload WITHOUT an .env edit or a server
#      restart.
#   2. BOTTEGA_OAUTH_CALLBACK_BASE_URL — a DEPLOYMENT-ONLY static override
#      for a FIXED public host (a DNS name / reverse proxy that never
#      rotates). Leave it unset when running the durable store + tunnel.sh.
# Unset (both) → local dev posture: the mints return the loopback URL
# (http://127.0.0.1:<port>), reachable only from the server's own host.
# Issue #211: the upload-link mint HEALTH-CHECKS the resolved base at mint
# time (GET <base>/, any non-5xx response = reachable). A dead URL — 5xx
# from the ingress (gone quick tunnel) or a transport failure — falls back
# to the loopback URL WITH a loud warning in the mint reply instead of
# silently minting a dead public link. With scripts/tunnel.sh, the store
# tracks the live tunnel so "refresh and re-mint" is all a rotation costs.
# BOTTEGA_OAUTH_CALLBACK_BASE_URL=https://bottega.example.com
#
# The durable public-base store path (default data/public-base-url, mode
# 0600). Override for tests / unusual data layouts, like
# EXECUTOR_GIT_TOKEN_FILE for the git PAT. scripts/tunnel.sh writes the live
# tunnel URL here; uploads/connects re-read it on every mint. Local dev:
# scripts/dev.sh exports this as the CANONICAL checkout's data/public-base-url
# (issue #293), so a server restarted from ANY repository worktree reads the
# the same store the tunnel writes. dev.sh shares the WHOLE dev stack the
# same way (issue #301): it pins COMPOSE_PROJECT_NAME to a stable dev
# identity — reusing the existing legacy canonical-basename stack
# (`camp-flavor`) when one is running (so a pre-#301 stack converges instead
# of stranding its egress subnet), else a stable hash of the canonical
# checkout's realpath (worktrees of one repo share a project while unrelated
# same-basename clones diverge) — and it exports the override's /data bind to
# BOTTEGA_DEV_DATA_DIR, the certs bind to BOTTEGA_DEV_CERTS_DIR, and the
# credential boundary's secret dir to BOTTEGA_PROXY_SECRETS_DIR (all in the
# canonical data/certs), so all worktrees reuse one egress network, one
# proxy/broker, one MITM CA, and one secret store.
# BOTTEGA_PUBLIC_BASE_URL_FILE=/app/data/public-base-url
#
# The stable local port the in-process inbound listener binds when set
# (default 0 = ephemeral, fine for local dev / tests). ONE Bun.serve serves
# every browser leg — /upload/* (#196), /oauth/callback (#198), and the #57
# webhook route — so a static tunnel or reverse proxy forwards to this ONE
# port and the target survives restarts.
# BOTTEGA_CALLBACK_PORT=18080

# --- Image tag --------------------------------------------------------------
# Tag the app services run (docker-compose.yml). Pin a known-good build per
# deploy — rollback = set this to the previous tag and up -d:
#   BOTTEGA_IMAGE_TAG=$(git rev-parse --short HEAD) docker compose build
BOTTEGA_IMAGE_TAG=local
