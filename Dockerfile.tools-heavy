# bottega tools image — HEAVY/optional layer (issue #63): the curated v1.1
# tools image plus the toolchains that do NOT fit the default CI build
# budget: Rust toolchain (rustup, minimal profile), kubectl, helm, gcloud
# (+ GKE auth plugin). Per-org opt-in ONLY — the default CI docker job
# builds Dockerfile.tools alone; nothing builds this file by default.
# Build it explicitly where an org needs it:
#
#   docker build -f Dockerfile.tools -t bottega-tools:latest .
#   docker build -f Dockerfile.tools-heavy -t bottega-tools-heavy:latest .
#
# gRPC-heavy CLIs (kubectl, gcloud) do not fit the iron-proxy HTTP boundary
# for credentialed calls (documented limitation, README "CLI surface"):
# they run for non-authenticated operations only.
FROM bottega-tools:latest

USER root

# Rust toolchain: rustup minimal profile. Homes live under /usr/local (not
# /root, which is 0700) so the runtime `bun` user (uid 1000) can execute
# cargo/rustc.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH="/usr/local/cargo/bin:${PATH}"
RUN curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs -o /tmp/rustup.sh \
    && sh /tmp/rustup.sh -y --profile minimal \
    && rm /tmp/rustup.sh \
    && rustup --version && cargo --version && rustc --version

# kubectl + helm: pinned official binaries; release assets use amd64/arm64
# while uname -m says x86_64/aarch64, hence the mapping.
ARG KUBECTL_VERSION=v1.36.3
ARG HELM_VERSION=v4.2.4
RUN curl -fsSL "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/$(uname -m | sed 's/x86_64/amd64/; s/aarch64/arm64/')/kubectl" -o /usr/local/bin/kubectl \
    && chmod +x /usr/local/bin/kubectl
RUN arch=$(uname -m | sed 's/x86_64/amd64/; s/aarch64/arm64/') \
    && curl -fsSL "https://get.helm.sh/helm-${HELM_VERSION}-linux-${arch}.tar.gz" -o /tmp/helm.tgz \
    && tar -xzf /tmp/helm.tgz -C /tmp \
    && mv "/tmp/linux-${arch}/helm" /usr/local/bin/helm \
    && rm -rf /tmp/helm.tgz "/tmp/linux-${arch}"

# gcloud: Google's apt repo (keyring + signed-by), cloud-sdk channel. The
# GKE auth plugin makes kubectl work against GKE clusters.
RUN apt-get update \
    && apt-get install -y --no-install-recommends apt-transport-https ca-certificates gnupg \
    && curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" > /etc/apt/sources.list.d/google-cloud-sdk.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends google-cloud-cli google-cloud-cli-gke-gcloud-auth-plugin \
    && rm -rf /var/lib/apt/lists/*

# Runtime user: back to `bun`, like the base tools image.
USER bun

# No CMD: same spawn semantics as the base tools image.
